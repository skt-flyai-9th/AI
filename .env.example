APP_NAME=FLY AI Service
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1

# Shared only between the main backend and this AI server.
INTERNAL_API_KEY=replace-with-a-long-random-value
# Deprecated compatibility option. Leave empty for new deployments.
ADMIN_API_TOKEN=
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgresql+psycopg://challenge:challenge@db:5432/challenge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

PIPELINE_CONFIG_PATH=config/pipeline.yaml
RANKER_DATA_DIR=runtime-data
EXPORT_DIR=exports
PIPELINE_TIMEOUT_SECONDS=3600
RANKING_SCHEDULE_HOUR_KST=6
RANKING_SCHEDULE_MINUTE_KST=0

# Analysis history retention. *_latest.json exports are overwritten, not accumulated.
HISTORY_CLEANUP_ENABLED=true
RUN_RETENTION_DAYS=90
FAILED_RUN_RETENTION_DAYS=14
MIN_SUCCESSFUL_RUNS_TO_KEEP=10
CLEANUP_SCHEDULE_HOUR_KST=4
CLEANUP_SCHEDULE_MINUTE_KST=30

APIFY_API_TOKEN=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Shortform Agent GPT application.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SHORTFORM_OPENAI_MODEL=gpt-4.1-mini
SHORTFORM_REQUEST_TIMEOUT_SECONDS=12
SHORTFORM_MAX_OUTPUT_TOKENS=1800
SHORTFORM_MAX_REQUEST_ATTEMPTS=2
SHORTFORM_MAX_PHOTO_INPUTS=4

# Database Knowledge Manager. Candidates remain reviewable by default.
DATABASE_OPENAI_MODEL=gpt-4.1-mini
DATABASE_REQUEST_TIMEOUT_SECONDS=60
DATABASE_MAX_OUTPUT_TOKENS=6000
DATABASE_GEMINI_MODEL=auto
DATABASE_VIDEO_ANALYSIS_TIMEOUT_SECONDS=300
DATABASE_MAX_REFERENCE_VIDEOS=5
DATABASE_REQUIRE_HUMAN_APPROVAL=true
DATABASE_MAINTENANCE_ENABLED=false
DATABASE_MAINTENANCE_WEEKDAY=0
DATABASE_MAINTENANCE_HOUR_KST=5
DATABASE_MAINTENANCE_MINUTE_KST=0

# Editing Agent GPT application, frame-context builder, and REALS Renderer.
EDITING_OPENAI_MODEL=gpt-4.1-mini
EDITING_REQUEST_TIMEOUT_SECONDS=30
EDITING_MAX_OUTPUT_TOKENS=5000
EDITING_LLM_MAX_REQUEST_ATTEMPTS=3
EDITING_RATE_LIMIT_RETRY_BASE_SECONDS=20
EDITING_MAX_REPAIR_ATTEMPTS=2
# Current CPU-only AI host envelope (2 vCPU / 8 GiB): decode each source once,
# retain compact frame evidence, and batch VLM frame analysis.
EDITING_MAX_KEYFRAMES_PER_VIDEO=3
EDITING_ANALYSIS_FRAME_WIDTH=360
EDITING_ANALYSIS_JPEG_QUALITY=7
EDITING_ANALYSIS_BATCH_FRAMES=24
EDITING_ANALYSIS_MAX_FRAMES_PER_VIDEO=48
EDITING_ANALYSIS_MAX_TOTAL_FRAMES=120
EDITING_ORPHAN_RECOVERY_ENABLED=false
EDITING_ORPHAN_STALE_SECONDS=2400
EDITING_ORPHAN_RECOVERY_INTERVAL_SECONDS=300
EDITING_ORPHAN_MAX_RECOVERY_ATTEMPTS=2
EDITING_ESTIMATED_SECONDS_PER_RUN=900
EDITING_TASK_TIMEOUT_SECONDS=2400
# Configure these from the active provider price sheet to enable cost estimates.
EDITING_INPUT_COST_PER_MILLION_USD=0
EDITING_OUTPUT_COST_PER_MILLION_USD=0
EDITING_MAX_VIDEOS_PER_RUN=6
EDITING_MAX_OUTPUT_DURATION_SECONDS=15
EDITING_MAX_SOURCE_DURATION_SECONDS=30
EDITING_DISABLED_EFFECT_IDS=SMOOTH_ZOOM
EDITING_FFPROBE_PATH=ffprobe
EDITING_FFMPEG_PATH=ffmpeg
EDITING_PROBE_TIMEOUT_SECONDS=45
EDITING_RENDERER_URL=http://renderer:8080
EDITING_RENDERER_TIMEOUT_SECONDS=1800
EDITING_RENDERER_HEALTH_TIMEOUT_SECONDS=3
EDITING_REALS_REGISTRY_PATH=reals-video-engine/registry
EDITING_REALS_ENGINE_PATH=reals-video-engine

# REALS renderer service. In production, set the public URL to a service/CDN
# reachable address instead of the local development value.
RENDERER_PUBLIC_BASE_URL=http://localhost:8080
RENDERER_WORK_DIR=runtime-data/renderer/work
RENDERER_OUTPUT_DIR=runtime-data/renderer/output
RENDERER_MAX_DOWNLOAD_BYTES=268435456
RENDERER_DOWNLOAD_TIMEOUT_SECONDS=300
RENDERER_FILE_URL_TTL_SECONDS=3600
REALS_FORCE_CPU=1
REALS_FFMPEG_PRESET_OVERRIDE=veryfast
