APP_NAME=FLY AI Service
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1

# Shared only between the main backend and this AI server.
INTERNAL_API_KEY=replace-with-a-long-random-value
# Deprecated compatibility option. Leave empty for new deployments.
ADMIN_API_TOKEN=

DATABASE_URL=postgresql+psycopg://challenge:challenge@db:5432/challenge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

PIPELINE_CONFIG_PATH=config/pipeline.yaml
RANKER_DATA_DIR=runtime-data
EXPORT_DIR=exports
PIPELINE_TIMEOUT_SECONDS=3600
RANKING_SCHEDULE_HOUR_KST=6
RANKING_SCHEDULE_MINUTE_KST=0

# Analysis history retention. *_latest.json exports are overwritten, not accumulated.
HISTORY_CLEANUP_ENABLED=true
RUN_RETENTION_DAYS=90
FAILED_RUN_RETENTION_DAYS=14
MIN_SUCCESSFUL_RUNS_TO_KEEP=10
CLEANUP_SCHEDULE_HOUR_KST=4
CLEANUP_SCHEDULE_MINUTE_KST=30

APIFY_API_TOKEN=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Shortform Agent GPT application.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SHORTFORM_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
SHORTFORM_REQUEST_TIMEOUT_SECONDS=12
SHORTFORM_MAX_OUTPUT_TOKENS=1800
SHORTFORM_MAX_PHOTO_INPUTS=4

# Editing Agent GPT application, video-context builder, and REALS Renderer service.
EDITING_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
EDITING_REQUEST_TIMEOUT_SECONDS=30
EDITING_MAX_OUTPUT_TOKENS=5000
EDITING_MAX_REPAIR_ATTEMPTS=2
# CPU-only free-tier envelope. Output remains 1080x1920, but inputs and the
# generated timeline are bounded so one render cannot exhaust the host.
EDITING_MAX_KEYFRAMES_PER_VIDEO=3
EDITING_MAX_VIDEOS_PER_RUN=6
EDITING_MAX_OUTPUT_DURATION_SECONDS=15
EDITING_MAX_SOURCE_DURATION_SECONDS=30
EDITING_DISABLED_EFFECT_IDS=SMOOTH_ZOOM
EDITING_FFPROBE_PATH=ffprobe
EDITING_FFMPEG_PATH=ffmpeg
EDITING_PROBE_TIMEOUT_SECONDS=45
EDITING_RENDERER_URL=http://renderer:8080
EDITING_RENDERER_TIMEOUT_SECONDS=1800
EDITING_RENDERER_HEALTH_TIMEOUT_SECONDS=3
EDITING_REALS_REGISTRY_PATH=reals-video-engine/registry
EDITING_REALS_ENGINE_PATH=reals-video-engine

# REALS renderer service. In production, set the public URL to a backend/CDN
# reachable address instead of the local development value.
RENDERER_PUBLIC_BASE_URL=http://localhost:8080
RENDERER_WORK_DIR=runtime-data/renderer/work
RENDERER_OUTPUT_DIR=runtime-data/renderer/output
RENDERER_MAX_DOWNLOAD_BYTES=268435456
RENDERER_DOWNLOAD_TIMEOUT_SECONDS=300
REALS_FORCE_CPU=1
REALS_FFMPEG_PRESET_OVERRIDE=veryfast
