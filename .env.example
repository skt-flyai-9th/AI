APP_NAME=Challenge Ranker API
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1
ADMIN_API_TOKEN=change-me-before-production

DATABASE_URL=postgresql+psycopg://challenge:challenge@db:5432/challenge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

PIPELINE_CONFIG_PATH=config/pipeline.yaml
RANKER_DATA_DIR=runtime-data
EXPORT_DIR=exports
PIPELINE_TIMEOUT_SECONDS=3600
RANKING_SCHEDULE_HOUR_KST=6
RANKING_SCHEDULE_MINUTE_KST=0

APIFY_API_TOKEN=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
